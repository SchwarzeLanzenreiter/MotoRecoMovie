{
  "name": "motorecomovie",
  "productName": "MotoRecoMovie",
  "version": "0.1.1",
  "description": "MotoRecoMovie: a desktop app that reframes Insta360 X6 .insv files together with MotoReco vehicle logs",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && tsx tools/notices.ts && electron-builder --win",
    "notices": "tsx tools/notices.ts",
    "fetch-assets": "tsx tools/fetch-assets.ts"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "mp4-muxer": "^5.2.2",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "build": {
    "appId": "com.motorecomovie.app",
    "productName": "MotoRecoMovie",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MotoRecoMovie"
    },
    "extraResources": [
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*",
          "!BUILD.json"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "build/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ]
  },
  "author": "SchwarzeLanzenreiter"
}
